# ══════════════════════════════════════════════════════════════
#  VRCDJ_bot — environment file (SECRETS)
#
#  1. Copy this file to  bot.env   (same folder)
#     Windows:  copy bot.env.example bot.env
#     (or just create bot.env by hand)
#  2. Fill in your values below.
#  3. NEVER commit bot.env — it is in .gitignore and holds your
#     Discord bot token.
# ══════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────────
# Your Discord bot token.
#   Discord Developer Portal → your application → Bot → Reset Token → copy.
#   Only this one value is required for the bot to run.
DISCORD_BOT_TOKEN=

# ── DASHBOARD (all optional — the bot still runs without them) ──
# A password to sign in to the LAN web dashboard.
#   Leave blank  → the dashboard generates a random one and prints it
#                  ONCE to the console when you first start it.
#   Set a value  → use that password instead (recommended for a server).
#   Use a long, random string. It is the gate to stop/start/toggle.
DASHBOARD_PASSWORD=

# Port the dashboard listens on (default 8720).
#   Reach it over your LAN at  http://<your-LAN-IP>:8720
#DASHBOARD_PORT=8720

# Secret used to sign the dashboard session cookie (default: auto-generated
# on every start — fine, it just means "sign out" if you restart).
#DASHBOARD_SECRET=

# ── ADVANCED (optional) ───────────────────────────────────────
# Override the public DJ master-list (a Google Sheet "anyone with the link
# can view" CSV export). Defaults to the community sheet baked into the code.
#DJ_SHEET_URL=https://docs.google.com/spreadsheets/d/<ID>/export?format=csv

# Set to 1 to run the dashboard WITHOUT auto-starting the bot (e.g. you
# start the bot separately with run_bot.bat, or you want it down).
#VRCDJ_NO_AUTOSTART=1
